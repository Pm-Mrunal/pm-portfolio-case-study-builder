# Personal data — do not commit
context-library/project-inputs*.md
context-library/writing-preferences.md
context-library/experience-library.md
context-library/portfolio-inputs.md

# Generated outputs — do not commit
outputs/*.md
!outputs/README.md
outputs/portfolio/*.md
outputs/portfolio/*.html
outputs/improve-skill-runs/
outputs/create-skill-runs/
outputs/portfolio-reviews/

# Session notes and tracker
briefings/*.md
!briefings/README.md

# Claude Code memory (contains personal user data)
.claude/projects/

# Local permission settings (contains personal file paths)
.claude/settings.local.json

# Skill run learnings — session-specific, user data
references/learnings.md
.claude/skills/*/references/

# Internal design skills — not for distribution
.claude/skills/improve-skill/
.claude/skills/create-skill/

# Playwright MCP working dir (session logs, page snapshots) — for /review-portfolio
.playwright-mcp/

# OS files
.DS_Store
Thumbs.db

# Editor files
.cursor/
.vscode/settings.json
*.swp
